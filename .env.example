# Resend API key for the contact form Server Action.
# Do not commit the real key. Verify the sending domain in Resend.
RESEND_API_KEY=

# Must be a verified sender, e.g. Güd Vector <info@gudvector.com>
RESEND_FROM="Güd Vector <info@gudvector.com>"

# Inbox that receives the form
CONTACT_TO=info@gudvector.com

# Canonical site URL for metadata, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://gudvector.com
